{
  "compilerOptions": {
    "noEmit": true,
    "target": "es2019",
    "module": "nodenext",
    "strict": true,
    "jsx": "react-jsx",
    "importHelpers": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "rootDir": ".",
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@tiptap/*": ["./packages/*/src/index.ts"],
      "@tiptap/editor/*": ["./packages/editor/src/*/index.ts"],
      "@tiptap/editor/extensions/*": ["./packages/editor/src/extensions/*/index.ts"],
      "@tiptap/editor/kits/*": ["./packages/editor/src/kits/*/index.ts"],
      "@tiptap/editor/pm/*": ["./packages/editor/src/pm/*/index.ts"],
      "@tiptap/react/*": ["./packages/react/src/*/index.ts"],
      "@tiptap/vue/*": ["./packages/vue/src/*/index.ts"]
    },
    "lib": ["esnext", "dom", "dom.iterable", "scripthost"]
  },
  "files": ["./env.d.ts"],
  "include": ["**/*.d.ts", "**/*.ts", "**/*.tsx", "**/*.vue"],
  "exclude": ["**/node_modules", "**/dist"]
}
