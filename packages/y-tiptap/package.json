{
  "name": "@tiptap/y-tiptap",
  "version": "3.0.9",
  "description": "Tiptap ProseMirror bindings for Yjs",
  "keywords": [
    "prosemirror",
    "tiptap",
    "yjs"
  ],
  "homepage": "https://tiptap.dev",
  "bugs": {
    "url": "https://github.com/ueberdosis/tiptap/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
