    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "vite-plus": "catalog:",
    "y-protocols": "^1.0.1",
    "yjs": "^13.6.13"
  },
  "peerDependencies": {
    "prosemirror-model": "^1.7.1",
    "prosemirror-state": "^1.2.3",
    "prosemirror-view": "^1.9.10",
    "y-protocols": "^1.0.1",
    "yjs": "^13.6.13"
  }
