    "directory": "packages/y-tiptap"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "files": [
    "src",
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
