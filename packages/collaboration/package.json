{
  "name": "@tiptap/collaboration",
  "version": "3.30.3",
  "description": "Yjs binding for Tiptap",
  "keywords": [
    "collaboration",
    "tiptap",
    "yjs"
  ],
  "homepage": "https://tiptap.dev",
  "bugs": {
    "url": "https://github.com/ueberdosis/tiptap/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ueberdosis/tiptap",
    "directory": "packages/collaboration"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/ueberdosis"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./caret": {
      "types": {
        "import": "./dist/caret/index.d.ts",
        "require": "./dist/caret/index.d.cts"
      },
      "import": "./dist/caret/index.js",
      "require": "./dist/caret/index.cjs"
    }
  },
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "@tiptap/editor": "workspace:^",
    "@tiptap/y-tiptap": "^3.0.7",
    "yjs": "^13.6.23"
  },
  "peerDependencies": {
    "@tiptap/editor": "workspace:*",
    "@tiptap/y-tiptap": "^3.0.7",
    "yjs": "^13"
  }
}
